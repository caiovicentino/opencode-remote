{
  "name": "opencode-remote",
  "private": true,
  "version": "0.2.0",
  "description": "Secure remote control for opencode from anywhere. Your machine, your code, end-to-end encrypted.",
  "type": "module",
  "bin": {
    "opencode-remote": "cli.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "dev:relay": "npm run dev --workspace apps/relay",
    "dev:daemon": "npm run dev --workspace apps/daemon",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages scripts --quiet",
    "test:unit": "tsx scripts/unit.test.ts",
    "test:e2e": "tsx scripts/reconnect.test.ts && tsx scripts/chunk.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "eslint": "^10.9.1",
    "typescript-eslint": "^8.68.0"
  }
}
