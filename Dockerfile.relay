# Relay image — build from the monorepo root:
#   docker build -f Dockerfile.relay -t opencode-remote/relay .
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/relay/package.json apps/relay/package.json
COPY packages/protocol/package.json packages/protocol/package.json
RUN npm ci --omit=dev --workspace apps/relay --workspace packages/protocol

FROM node:22-alpine
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json ./package.json
COPY packages/protocol/src packages/protocol/src
COPY packages/protocol/package.json packages/protocol/package.json
COPY apps/relay/src apps/relay/src
COPY apps/relay/package.json apps/relay/package.json
ENV NODE_ENV=production
EXPOSE 8787
CMD ["node_modules/.bin/tsx", "apps/relay/src/index.ts"]
