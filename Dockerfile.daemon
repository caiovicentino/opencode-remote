# Daemon image — build from the monorepo root:
#   docker build -f Dockerfile.daemon -t opencode-remote/daemon .
#
# Needs to reach the local opencode server. Compose handles
# host.docker.internal on Linux via extra_hosts; see docker-compose.yml.
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/daemon/package.json apps/daemon/package.json
COPY packages/protocol/package.json packages/protocol/package.json
RUN npm ci --omit=dev --workspace apps/daemon --workspace packages/protocol

FROM node:22-alpine
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json ./package.json
COPY packages/protocol/src packages/protocol/src
COPY packages/protocol/package.json packages/protocol/package.json
COPY apps/daemon/src apps/daemon/src
COPY apps/daemon/package.json apps/daemon/package.json
ENV NODE_ENV=production
# identity + push subscriptions persist on the mounted volume
VOLUME ["/root/.opencode-remote"]
CMD ["node_modules/.bin/tsx", "apps/daemon/src/index.ts"]
