{
  "name": "@ocr/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "OpenCode Remote desktop shell (Electron) — loads the @ocr/web UI",
  "type": "commonjs",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "tsc && npm run build:daemon",
    "build:daemon": "node scripts/bundle-daemon.mjs",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "38.8.6",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.12",
    "typescript": "^5.6.0"
  },
  "license": "AGPL-3.0-only"
}
